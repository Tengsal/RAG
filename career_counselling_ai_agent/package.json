{
  "name": "career-counselling-voice-agent",
  "version": "1.0.0",
  "description": "Standalone AI voice-calling agent for career counselling — calls leads, counsels in Hinglish, and updates Google Sheets after each call. Pipeline: Deepgram STT → Groq (openai/gpt-oss-20b) → Sarvam TTS, with barge-in and a 10s silence cutoff.",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "tsx src/server.ts",
    "dev:worker": "tsx src/worker.ts dev",
    "build": "tsc",
    "start": "node --max-old-space-size=2048 dist/server.js"
  },
  "dependencies": {
    "@deepgram/sdk": "4.11.3",
    "@livekit/agents": "1.0.44",
    "@livekit/rtc-node": "0.13.24",
    "axios": "1.13.5",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "2.15.0",
    "mongoose": "^8.12.1",
    "openai": "6.22.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.19.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
