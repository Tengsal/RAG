# ══════════════════════════════════════════════════════════════
# CAREER COUNSELLING AI VOICE AGENT — .env.example
# Copy to .env and fill in your own credentials.
# ══════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────
PORT=5100
WORKER_PORT=1043
AGENT_NAME=career-counsellor

# ── LiveKit ────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_secret

# ── Vobiz SIP (outbound dialing) ───────────────────────
VOBIZ_SIP_DOMAIN=xxxx.sip.vobiz.ai
VOBIZ_USERNAME=your_vobiz_username
VOBIZ_PASSWORD=your_vobiz_auth_token
VOBIZ_OUTBOUND_NUMBER=+91xxxxxxxxxx
SIP_TRUNK_ID=ST_xxxxxxxxxxxx

# ── AI Pipeline (FAST config — do not use reasoning models here) ──
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.5
GROQ_TOP_P=1
GROQ_MAX_COMPLETION_TOKENS=100

DEEPGRAM_API_KEY=your_deepgram_key
SARVAM_API_KEY=sk_...

# ── Voice & language ───────────────────────────────────
SARVAM_VOICE=kavya
SARVAM_MODEL=bulbul:v3
SARVAM_LANGUAGE=en-IN
AGENT_PERSONA_NAME=Kavya
COMPANY_NAME=Career Guidance Centre

# ── Google Sheets lead logging ─────────────────────────
GOOGLE_SHEET_WEBHOOK_URL=

# ── Call behaviour ─────────────────────────────────────
MAX_CALL_DURATION_MS=720000
BULK_CALL_DELAY_MS=15000
